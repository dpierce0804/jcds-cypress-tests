{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "types": [
      "cypress",
      "node"
    ],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "cypress.config.ts",
    "cypress/**/*.ts"
  ]
}
